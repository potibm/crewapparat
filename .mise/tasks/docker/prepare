#!/usr/bin/env bash
#MISE description="Setup Docker buildx builder (Internal)"
#MISE hide=true

set -e 

if ! docker buildx inspect crewapparat-builder >/dev/null 2>&1; then
    echo "🔧 Creating buildx builder 'crewapparat-builder'..."
    docker buildx create --name crewapparat-builder --use --bootstrap
else
    echo "✅ Using existing buildx builder 'crewapparat-builder'"
    docker buildx use crewapparat-builder
    docker buildx inspect --bootstrap > /dev/null
fi